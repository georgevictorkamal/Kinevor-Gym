{
  "openapi": "3.0.1",
  "info": {
    "title": "Kinevor Staff Dashboard API",
    "description": "Branch KPIs, activity and operational alerts for Kinevor staff.",
    "version": "v1"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Kinevor.Modules.StaffDashboard.DemoApi"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/staff-dashboard": {
      "get": {
        "tags": [
          "StaffDashboard"
        ],
        "parameters": [
          {
            "name": "branchId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 7
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/StaffDashboardDtoApiResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffDashboardDtoApiResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffDashboardDtoApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/staff-dashboard/alerts": {
      "get": {
        "tags": [
          "StaffDashboard"
        ],
        "parameters": [
          {
            "name": "branchId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardAlertsDtoApiResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardAlertsDtoApiResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardAlertsDtoApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/staff-dashboard/branches": {
      "get": {
        "tags": [
          "StaffDashboard"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardBranchDtoIReadOnlyListApiResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardBranchDtoIReadOnlyListApiResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardBranchDtoIReadOnlyListApiResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DashboardActivityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "branchId": {
            "type": "string",
            "format": "uuid"
          },
          "branchName": {
            "type": "string",
            "nullable": true
          },
          "branchCity": {
            "type": "string",
            "nullable": true
          },
          "kind": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "DashboardAlertDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "branchId": {
            "type": "string",
            "format": "uuid"
          },
          "branchName": {
            "type": "string",
            "nullable": true
          },
          "branchCity": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true
          },
          "severity": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "dueAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "reference": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DashboardAlertsDto": {
        "type": "object",
        "properties": {
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "branchId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "branchName": {
            "type": "string",
            "nullable": true
          },
          "branchCity": {
            "type": "string",
            "nullable": true
          },
          "alerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardAlertDto"
            },
            "nullable": true
          },
          "branches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardBranchDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DashboardAlertsDtoApiResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/DashboardAlertsDto"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DashboardBranchDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          },
          "activeMembers": {
            "type": "integer",
            "format": "int32"
          },
          "occupancyNow": {
            "type": "integer",
            "format": "int32"
          },
          "occupancyPercent": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "DashboardBranchDtoIReadOnlyListApiResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardBranchDto"
            },
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DashboardComparisonDto": {
        "type": "object",
        "properties": {
          "activeMembersPercent": {
            "type": "number",
            "format": "double"
          },
          "revenuePercent": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "DashboardSummaryDto": {
        "type": "object",
        "properties": {
          "totalMembers": {
            "type": "integer",
            "format": "int32"
          },
          "activeMembers": {
            "type": "integer",
            "format": "int32"
          },
          "occupancyNow": {
            "type": "integer",
            "format": "int32"
          },
          "occupancyPercent": {
            "type": "number",
            "format": "double"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          },
          "checkInsToday": {
            "type": "integer",
            "format": "int32"
          },
          "bookingsToday": {
            "type": "integer",
            "format": "int32"
          },
          "revenueMonth": {
            "type": "number",
            "format": "double"
          },
          "outstandingInvoices": {
            "type": "integer",
            "format": "int32"
          },
          "outstandingAmount": {
            "type": "number",
            "format": "double"
          },
          "comparison": {
            "$ref": "#/components/schemas/DashboardComparisonDto"
          }
        },
        "additionalProperties": false
      },
      "DashboardTrendPointDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "label": {
            "type": "string",
            "nullable": true
          },
          "checkIns": {
            "type": "integer",
            "format": "int32"
          },
          "bookings": {
            "type": "integer",
            "format": "int32"
          },
          "revenue": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": {}
      },
      "StaffDashboardDto": {
        "type": "object",
        "properties": {
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "branchId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "branchName": {
            "type": "string",
            "nullable": true
          },
          "branchCity": {
            "type": "string",
            "nullable": true
          },
          "days": {
            "type": "integer",
            "format": "int32"
          },
          "summary": {
            "$ref": "#/components/schemas/DashboardSummaryDto"
          },
          "trend": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardTrendPointDto"
            },
            "nullable": true
          },
          "activity": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardActivityDto"
            },
            "nullable": true
          },
          "alerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardAlertDto"
            },
            "nullable": true
          },
          "branches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardBranchDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StaffDashboardDtoApiResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/StaffDashboardDto"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "DemoRole": {
        "type": "apiKey",
        "description": "Demo role: Admin or Staff. Optionally add X-Branch-Id.",
        "name": "X-Demo-Role",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "DemoRole": []
    }
  ]
}
